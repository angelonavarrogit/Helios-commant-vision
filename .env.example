# ─────────────────────────────────────────────────────────────
# HELIOS — Personal Intelligence & Awareness System — example env
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=local                 # local | prod
APP_NAME=helios
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=mysql+pymysql://app:changeme@mysql:3306/aipic
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=aipic
MYSQL_USER=app
MYSQL_PASSWORD=changeme

# LLM provider (default: local Ollama — see ADR-016)
LLM_PROVIDER=ollama           # ollama | openai
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# OpenAI is opt-in only; leave empty when using Ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM budget / cost guardrails
LLM_MAX_CALLS_PER_HOUR=200

# Telegram (used from Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=    # comma-separated user IDs, e.g. 12345,67890

# Google OAuth (used from Phase 4 — read-only scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
# Fernet/AES key for encryption-at-rest of OAuth material (Phase 4).
# Generate a strong random value; keep OUT of git.
ENCRYPTION_KEY=
# Shared secret required to call POST /emails/process (N8N -> backend)
SERVICE_API_TOKEN=

# HELIOS COMMAND auth (Phase 5.7)
OWNER_USERNAME=owner
# Generate with: python backend/scripts/hash_password.py
OWNER_PASSWORD_HASH=
# Random secret used to sign session cookies (keep out of git).
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Public base URL used to build the OAuth redirect URI.
# LOCAL:      http://localhost:8000
# PRODUCTION: https://api.helios.tudominio.com  (your public API URL via Cloudflare Tunnel)
PUBLIC_BASE_URL=http://localhost:8000
# Allowed frontend origins (comma-separated) for CORS with credentials.
# LOCAL:      http://localhost:5173
# PRODUCTION: https://helios.tudominio.com  (your public frontend URL)
CORS_ORIGINS=http://localhost:5173
# Public API URL baked into the frontend bundle at BUILD time (must match
# PUBLIC_BASE_URL in production). Changing it requires rebuilding the frontend.
# LOCAL:      http://localhost:8000
# PRODUCTION: https://api.helios.tudominio.com
VITE_API_BASE_URL=http://localhost:8000

# Processing guardrails
MAX_EMAIL_BODY_CHARS=50000
# Rate limit for POST /emails/process (calls per minute per account).
PROCESS_RATE_LIMIT_PER_MINUTE=120    # defensive truncation
