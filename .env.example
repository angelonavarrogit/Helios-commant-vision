# ─────────────────────────────────────────────────────────────
# AI Personal Intelligence Center — Example environment file
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=local                 # local | prod
APP_NAME=ai-personal-intelligence
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=mysql+pymysql://app:changeme@mysql:3306/aipic
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=aipic
MYSQL_USER=app
MYSQL_PASSWORD=changeme

# LLM provider (default: local Ollama — see ADR-016)
LLM_PROVIDER=ollama           # ollama | openai
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# OpenAI is opt-in only; leave empty when using Ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM budget / cost guardrails
LLM_MAX_CALLS_PER_HOUR=200

# Telegram (used from Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=    # comma-separated user IDs, e.g. 12345,67890

# Google OAuth (used from Phase 4 — read-only scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
# Fernet/AES key for encryption-at-rest of OAuth material (Phase 4).
# Generate a strong random value; keep OUT of git.
ENCRYPTION_KEY=
# Shared secret required to call POST /emails/process (N8N -> backend)
SERVICE_API_TOKEN=

# Processing guardrails
MAX_EMAIL_BODY_CHARS=50000    # defensive truncation
